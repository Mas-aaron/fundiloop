# Copy to .env and fill in real values. Never commit .env.
# Mock mode (default): whole loop runs offline with realistic sample data.
MOCK_META=true

# Demo mode (default true): if the camera or a Meta API call fails, fall
# back to mock adapters and show a "fallback" badge instead of crashing.
# Toggle live in the UI header or via POST /api/config/demo.
DEMO_MODE=true

# Meta API credentials (leave empty for mock mode).
META_API_KEY=LLM_1104412658862765_5E6FUXuIvsC8iMp9NoIFbkoWyws
# Base URL for Meta Model API calls (Muse chat + SAM vision). Call patterns
# mirror the legacy clients in backend/muse_client.py and backend/sam_client.py.
META_API_BASE_URL=https://api.meta.ai/v1
# Seconds before a Meta API call times out (falls back, never crashes).
META_API_TIMEOUT=30
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=meta-voice-1
# Voice Transcribe endpoint. Empty = META_API_BASE_URL + /asr/transcribe
# (legacy backend/transcribe.py pattern). Set only to override.
META_ASR_URL=

# Overhead ESP32-CAM still-frame URL, e.g. http://fundiloop.local/capture
# or http://192.168.1.50/capture. Empty = mock camera frames.
CAMERA_FRAME_URL=

# Patient ESP32 over USB serial (Windows: COM3, Linux: /dev/ttyUSB0).
SERIAL_PORT=
SERIAL_BAUD=115200
