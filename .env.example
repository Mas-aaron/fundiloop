# Copy to .env and fill in real values. Never commit .env.
#
# REAL setup (documented default): live ESP32-CAM + live Meta models.
# With MOCK_META=false every mock adapter raises if called, camera and
# Meta API failures return HTTP 502 with the real error, and every model
# call is logged to backend/data/logs/model_calls.jsonl.
MOCK_META=false

# Meta API credentials + endpoint. Base URL is the root for Muse chat and
# SAM vision calls (OpenAI-compatible, mirroring the legacy clients in
# backend/muse_client.py and backend/sam_client.py). The key is never
# printed by /api/status (only meta_api_configured: true/false).
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Seconds before a Meta API call times out (surfaced as HTTP 502).
META_API_TIMEOUT=30
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0
# Voice Transcribe one-shot endpoint. Empty = META_API_BASE_URL + /asr/transcribe
# (legacy backend/transcribe.py pattern). Set only to override.
META_ASR_URL=
# Realtime (live) transcription WebSocket. Empty = META_API_BASE_URL + /asr/realtime
# (https -> wss). This is the endpoint the live voice path uses.
META_ASR_REALTIME_URL=

# Overhead ESP32-CAM on your LAN (it is already mounted and serving):
# MJPEG stream for the live preview, still endpoint for analysis frames.
CAMERA_STREAM_URL=http://192.168.1.50:81/stream
CAMERA_CAPTURE_URL=http://192.168.1.50/capture
# Legacy alias for CAMERA_CAPTURE_URL (still honored if the new var is empty).
# CAMERA_FRAME_URL=

# Patient ESP32 over USB serial (Windows: COM3, Linux: /dev/ttyUSB0).
SERIAL_PORT=
SERIAL_BAUD=115200
# Per-command serial timeout in seconds. The probe adapts across 115200 and
# 9600 baud on a silent board, then short-circuits instead of re-waiting.
SERIAL_TIMEOUT=4.0

# Sense timing (defaults shown). The serial probe reads while the camera
# settles, so lowering SETTLE_SECONDS only trims the vision gate.
SETTLE_SECONDS=1.0
SETTLE_MAX_WAIT_S=3.0

# Offline development only: MOCK_META=true re-enables the mock adapters
# (mock SAM/Muse/voice/probe answers, phone-snap camera). Never use for proof.
